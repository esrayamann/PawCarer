{
  "info": {
    "name": "Paw-Carer - Esra Yaman API Testleri",
    "description": "PawCarer backend API testleri (Vercel domain).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Kimlik Doğrulama",
      "item": [
        {
          "name": "1. Müşteri (Owner) Kayıt Ol",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@esra.com\",\n  \"password\": \"123456\",\n  \"fullName\": \"Esra Hayvan Sahibesi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/owner",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", "owner"]
            }
          }
        },
        {
          "name": "2. Bakıcı (Sitter) Kayıt Ol",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sitter@esra.com\",\n  \"password\": \"123456\",\n  \"fullName\": \"Esra Bakıcı\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/sitter",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", "sitter"]
            }
          }
        },
        {
          "name": "3. Giriş Yap (Login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@esra.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Profil Güncelleme",
      "item": [
        {
          "name": "8. Kullanıcı Hesap Bilgilerini Güncelle",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Esra Yaman (Güncel)\",\n  \"location\": \"Kadıköy, İstanbul\",\n  \"phoneNumber\": \"0555 123 4567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "profile"]
            }
          }
        },
        {
          "name": "7. Bakıcı Hesap Bilgilerini Güncelle",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sitterAuthToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hourlyRate\": 450.5,\n  \"bio\": \"Hayvanları çok severim ve 3 yıldır bakıcılık yapıyorum!\",\n  \"acceptedPetTypes\": [\"Kedi\", \"Köpek\"],\n  \"acceptedPetBreeds\": [\"Siyam\", \"Golden Retriever\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sitters/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sitters", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Yorum & Admin",
      "item": [
        {
          "name": "4. Bakıcıya Yorum Yap",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sitterId\": \"{{sitterProfileId}}\",\n  \"rating\": 5,\n  \"comment\": \"Gerçekten harika ilgilendi, gözüm hiç arkada kalmadı!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"]
            }
          }
        },
        {
          "name": "5. Yorumlarda Yıldız Ortalaması Alma",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sitters/{{sitterProfileId}}/rating",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sitters", "{{sitterProfileId}}", "rating"]
            }
          }
        },
        {
          "name": "6. Admin: Kullanıcı Sil",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAuthToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{targetUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{targetUserId}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://paw-carer.vercel.app",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "OWNER_KULLANICISININ_TOKENI",
      "type": "string"
    },
    {
      "key": "sitterAuthToken",
      "value": "SITTER_KULLANICISININ_TOKENI",
      "type": "string"
    },
    {
      "key": "sitterProfileId",
      "value": "ÖRN_YORUM_YAPILACAK_BAKICININ_IDSI",
      "type": "string"
    },
    {
      "key": "adminAuthToken",
      "value": "ADMIN_KULLANICISININ_TOKENI",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "SILINECEK_HEDEF_KULLANICININ_IDSI",
      "type": "string"
    }
  ]
}